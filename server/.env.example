PORT=3000
HOST=0.0.0.0
# 仅本地开发兜底；生产环境的对外 URL（二维码/微信回调/SEO）一律按当前请求域名动态推导，无需设置
BASE_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
DATA_DIR=
MAX_UPLOAD_MB=5

ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123456

# mock = 本地演示一键模拟支付；wechat = 微信支付 V3 Native
PAY_MODE=mock
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=
WECHAT_PLATFORM_CERT=
