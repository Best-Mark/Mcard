{
  "name": "唐笺 电子名片",
  "appid": "",
  "description": "一扫即存、永久有效的电子名片",
  "versionName": "1.0.0",
  "versionCode": "100",
  "vueVersion": "3",
  "mp-weixin": {
    "appid": "",
    "setting": { "urlCheck": false, "es6": true, "postcss": true },
    "__usePrivacyCheck__": true,
    "requiredPrivateInfos": ["getLocation", "chooseLocation"],
    "permission": {
      "scope.userLocation": {
        "desc": "用于名片集市按距离为你发现附近的业务伙伴、地图选点定位名片地址，仅在你主动操作时获取"
      },
      "scope.writePhotosAlbum": {
        "desc": "用于将你的名片二维码、实体名片版式保存到相册"
      }
    }
  },
  "mp-alipay": { "appid": "" },
  "mp-toutiao": { "appid": "" }
}
